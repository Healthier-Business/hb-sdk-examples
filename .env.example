# Copy this file to .env and fill in HB_API_KEY. .env is ignored by git.

# Your sandbox API key (hbk_...). Ask the Hub team for one (they issue it with `php artisan sandbox:issue-key`; it is shown once).
# It stays on the server and is never sent to the browser. A sandbox key only sees the sandbox course below.
HB_API_KEY=

# The Hub address. The sandbox lives on the normal Hub address.
HB_BASE_URL=https://hub.hbcompliance.co.uk

# The address this example is served from. These are the origins the sandbox accepts with no set-up:
# http://localhost:3000, :5173, :8000 and :8080.
APP_ORIGIN=http://localhost:3000
PORT=3000

# The sandbox candidate that is "signed in" in this demo (a fixed candidate_ref of the sandbox).
HB_CANDIDATE_REF=5a4d0b1e-0000-4000-8000-000000900001

# The sandbox course. A course session AND the test session both use this course id.
HB_SANDBOX_COURSE_ID=900001
# The id of the sandbox course's test. For reference only: the examples do not read it, because a test session is
# created with the course id above (Hub finds the test of that course).
HB_SANDBOX_TEST_ID=900001

# Occupational health form: the numeric id of an OH request that still has a form to answer, and the shortcode of
# that form. THERE IS NO SANDBOX OH REQUEST YET, and a sandbox key does not carry the occupational-health:embed:create
# scope, so these stay empty and the OH example will not open until you supply them from an OH account of your own.
HB_OH_REQUEST_ID=
HB_OH_FORM_SHORTCODE=
