# Copy this file to .env and fill in the values. .env is ignored by git.

# Your sandbox API key (hbk_test_...). It stays on the server and is never sent to the browser.
# A sandbox key only sees the sandbox course and the sandbox test below.
HB_API_KEY=

# The sandbox address, shown on the sandbox page of the developer portal.
# TODO: put the final sandbox URL here once the Hub team publishes it.
HB_BASE_URL=

# The address this example is served from. It must be registered under Developer > Embed in Hub.
APP_ORIGIN=http://localhost:3000
PORT=3000

# The person who is "signed in" in this demo (a candidate_ref from the Hub API).
# TODO: use the sandbox candidate_ref given by the Hub team.
HB_CANDIDATE_REF=

# The sandbox course and the sandbox test.
# TODO: fill in the final ids once the Hub team has created them.
HB_SANDBOX_COURSE_ID=
HB_SANDBOX_TEST_ID=

# Occupational health form: the numeric id of an OH request that still has a form to answer,
# and the shortcode of that form.
# TODO: fill in once a sandbox OH request exists.
HB_OH_REQUEST_ID=
HB_OH_FORM_SHORTCODE=
