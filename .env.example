# Copy this file to .env and fill in HB_API_KEY. .env is ignored by git.

# Your sandbox test key (hbk_test_...), created in the developer portal at https://dev.hbcompliance.co.uk (shown once).
# It stays on the server and is never sent to the browser.
HB_API_KEY=

# The sandbox address. The SDK adds /api/v2.
HB_BASE_URL=https://dev.hbcompliance.co.uk/sandbox

# The address this example is served from. The sandbox always accepts http://localhost on any port.
APP_ORIGIN=http://localhost:3000
PORT=3000

# The sandbox demo candidate that is "signed in" in this demo.
HB_CANDIDATE_REF=5a4d0b1e-0000-4000-8000-0000000000d1

# The sandbox course. A course session AND the test session both use this course id (1 to 8; 9 is not embeddable).
HB_SANDBOX_COURSE_ID=1

# Occupational health: the sandbox demo request and its form.
HB_OH_REQUEST_ID=999
HB_OH_FORM_SHORTCODE=clinical_occupational_health
